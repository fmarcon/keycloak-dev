# Copie para .env e troque os valores.

POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=troque-esta-senha

KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=troque-esta-senha

# URL publica HTTPS que o Keycloak usa para emitir tokens.
# Deve ser a URL que o browser ve (nginx), nao o host interno.
# /etc/hosts do host deve apontar auk.ucs.br -> 127.0.1.1.
KC_HOSTNAME=https://auk.ucs.br

# Portas publicadas pelo nginx no host (80 e 443 exigem dockerd root).
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Porta do phpLDAPadmin no host (UI do LDAP de dev).
PHPLDAPADMIN_PORT=8081

# 1 = apaga e re-semeia o LDAP no proximo boot (entryUUIDs mudam; imports
# do Keycloak ficam stale — apague o realm dev e reinicie o keycloak).
# Padrao: persistir.
LDAP_RESEED=false
