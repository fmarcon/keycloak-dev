# Issuer do realm dev (via nginx). O Flask descobre os endpoints via .well-known.
OIDC_ISSUER_URL=https://auk.ucs.br/realms/dev

# Client "flask-lab" criado no console admin do Keycloak (realm dev), tipo Confidential.
OIDC_CLIENT_ID=flask-lab
OIDC_CLIENT_SECRET=COLE_AQUI_O_CLIENT_SECRET

# URL que o Keycloak usa para voltar com o code (deve casar com "Valid redirect URIs" do client).
# ATENCAO: a porta depende de qual app voce roda:
#   - app.py (manual)        -> http://localhost:5000/callback
#   - app_authlib.py (lib)   -> http://localhost:5000/callback
OIDC_REDIRECT_URI=http://localhost:5000/callback

# Apos logout no Keycloak, browser volta para ca (registre em "Valid post logout redirect URIs").
# Use a mesma porta do OIDC_REDIRECT_URI acima (5000 p/ app.py, 5000 p/ app_authlib.py).
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5000/

# Como o client se autentica no token endpoint: post (client_secret no body) ou basic (HTTP Basic).
OIDC_CLIENT_AUTH_METHOD=post

# O Keycloak de dev usa cert self-signed: apontar para o cert usado pelo nginx evita verify=False.
# Se o issuer for acessado com cert valido/aprovado, apague esta linha.
OIDC_CA_BUNDLE=../nginx/certs/fullchain.pem

# Chave para assinar o cookie de sessao do Flask (troque por valor aleatorio).
SECRET_KEY=troque-isto-por-um-segredo-aleatorio